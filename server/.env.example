# ສຳເນົາໄຟລ໌ນີ້ເປັນ .env ແລ້ວແກ້ໄຂຄ່າໃຫ້ຖືກຕ້ອງ — ຫ້າມ commit .env ຈິງເຂົ້າ git
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=asb_logistics
DB_USER=root
DB_PASS=

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

APP_NAME="ASB ບໍລິການຂົນສົ່ງ ແລະ ຮັບເຄື່ອງຈາກແອັບຈີນ"
TRACKING_PREFIX=ASB
